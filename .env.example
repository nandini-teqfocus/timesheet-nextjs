# Application Server URL
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_key_here

# Salesforce OAuth 2.0 Connected App Credentials
SALESFORCE_CLIENT_ID=your_salesforce_consumer_key
SALESFORCE_CLIENT_SECRET=your_salesforce_consumer_secret
SALESFORCE_USERNAME=your_integration_user_username@org.com
SALESFORCE_INSTANCE_URL=https://time-sheet.my.salesforce.com
SALESFORCE_LOGIN_URL=https://login.salesforce.com

# Server-Side RSA Private Key for JWT Bearer Authentication (Keep Secret!)
SALESFORCE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# API Configuration
NEXT_PUBLIC_APP_NAME="Teqfocus Timesheet Portal"
NEXT_PUBLIC_API_BASE_URL="/api/salesforce"
