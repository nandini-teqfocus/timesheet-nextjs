    <decisions>
        <name>Decision_CheckEnable</name>
        <label>Decision - Auto Close Enabled?</label>
        <locationX>380</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>IsEnabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varEnableAutoClose</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetJobsToClose</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_HasJobs</name>
        <label>Decision - Jobs Found?</label>
        <locationX>182</locationX>
        <locationY>566</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>HasJobs</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varJobRecords</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Jobs</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Scheduled flow that runs daily to auto-close job postings when Closing_Date__c &lt;= TODAY and config allows it.</description>
    <label>EmpRef_AutoCloseJobFlow</label>
    <loops>
        <name>Loop_Jobs</name>
        <label>Loop - Jobs</label>
        <locationX>50</locationX>
        <locationY>674</locationY>
        <assignNextValueToReference>varCurrentJob</assignNextValueToReference>
        <collectionReference>varJobRecords</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_PrepareUpdate</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_JobsToClosed</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GetJobsToClose</name>
        <label>Get Jobs To Close</label>
        <locationX>182</locationX>
        <locationY>458</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_HasJobs</targetReference>
        </connector>
        <faultConnector>
            <targetReference>AssignOnGetJobsFault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Closing_Date__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </filters>
        <object>Job_Posting__c</object>
        <outputReference>varJobRecords</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Status__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>GetReferralConfig</name>
        <label>Get Referral Config</label>
        <locationX>380</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_ConfigFlag</targetReference>
        </connector>
        <faultConnector>
            <targetReference>AssignOnConfigFault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Default</stringValue>
            </value>
        </filters>
        <object>Referral_Config__mdt</object>
        <outputReference>varConfigRecord</outputReference>
        <queriedFields>Enable_Auto_Close__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_JobsToClosed</name>
        <label>Update Jobs to Closed</label>
        <locationX>50</locationX>
        <locationY>974</locationY>
        <faultConnector>
            <targetReference>AssignOnUpdateFault</targetReference>
        </faultConnector>
        <inputReference>varJobRecords</inputReference>
    </recordUpdates>
    <start>
        <locationX>254</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetReferralConfig</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-05-18</startDate>
            <startTime>00:30:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
